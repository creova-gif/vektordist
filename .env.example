# ==============================================================================
# VektorDist Declarative Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` for local development or inject these variables via
# Kubernetes Secrets / ConfigMaps in production.
#
# Precedence order in `VektorNodeConfig` (`src/config.rs`):
#   1. Explicit CLI flags (`vektordist node --id ...`, `vektordist gateway ...`)
#   2. `VEKTORDIST_*` environment variables (below)
#   3. Declarative TOML / `key = value` file (`--config ./node.toml`)
#   4. Built-in `VektorNodeConfig::default()` values
#
# SECURITY WARNING: Never commit a populated `.env` file or production secrets
# to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Node & Network Topology
# ------------------------------------------------------------------------------

# Unique positive integer identifier (`> 0`) for this data-plane replica node.
VEKTORDIST_NODE_ID=1

# gRPC socket address bound by `ShardReplicaRpcServer` (`VEKTORDIST_LISTEN` alias also accepted).
VEKTORDIST_LISTEN_ADDR=127.0.0.1:50052

# Upstream `TopologyRpc` / Raft coordinator endpoint (`VEKTORDIST_COORD` alias also accepted).
VEKTORDIST_COORD_ADDR=127.0.0.1:50051

# HTTP/1.1 Zero-Trust REST, Web Control Console & Prometheus gateway bind address.
VEKTORDIST_GATEWAY_LISTEN=127.0.0.1:8080

# Persistent directory storing shard CRC32 WALs (`*.wal`), zero-copy segments (`*.vdsg`),
# atomic checkpoints (`*.ckpt`), durable collections (`collections.vdcl`), and audit logs.
VEKTORDIST_DATA_DIR=/tmp/vektordist-node

# ------------------------------------------------------------------------------
# 2. Cluster Sharding & Quorum Durability
# ------------------------------------------------------------------------------

# Primary sharded cluster vector dimensionality (`> 0`).
VEKTORDIST_DIMENSIONS=768

# Number of deterministic SplitMix64 logical shards across the cluster (`> 0`).
VEKTORDIST_NUM_SHARDS=16

# Replica factor (`RF`) per shard (`1` primary + `RF - 1` followers).
VEKTORDIST_REPLICATION_FACTOR=3

# Minimum `fsync`-confirmed replicas (`W`) required before acknowledging a write (`1 <= W <= RF`).
VEKTORDIST_WRITE_QUORUM=2

# Distance metric for the default sharded index (`cosine` or `l2`).
VEKTORDIST_METRIC=cosine

# ------------------------------------------------------------------------------
# 3. HNSW Graph Index Tuning
# ------------------------------------------------------------------------------

# Bidirectional neighbor edges per node (`M > 0`; layer-0 uses `M_max0 = 2 * M = 32`).
VEKTORDIST_HNSW_M=16

# Candidate beam width during HNSW index construction (`> 0`).
VEKTORDIST_HNSW_EF_CONSTRUCTION=128

# Default query-time HNSW candidate beam width (`> 0`; dynamically bounded under M6 controller).
VEKTORDIST_HNSW_EF_SEARCH=64

# ------------------------------------------------------------------------------
# 4. Zero-Trust Security (`SecurityGate` Master Secret)
# ------------------------------------------------------------------------------

# Optional 256-bit (64-hex-character) master secret enabling constant-time MAC verification
# of scoped `vdk.<key_id>.<hex_tag>` bearer tokens across `/v1/*` gateway endpoints.
# When unset or empty, local development gateways run with token enforcement disabled.
#
# Step 1 — Generate a cryptographically random 32-byte hex secret:
#   openssl rand -hex 32
#
# Step 2 — Export `VEKTORDIST_MASTER_SECRET` and mint least-privilege tenant API keys
#          (monotonic RBAC roles: `reader` < `writer` < `admin`):
#   cargo run --release -- keygen --org <org> --role writer
#
# Leave commented or empty in templates; inject via a secret manager in production:
# VEKTORDIST_MASTER_SECRET=

# ------------------------------------------------------------------------------
# 5. Optional Operator & Client SDK Conventions
# ------------------------------------------------------------------------------
# Convenience environment variables commonly consumed by CLI scripts, curl runbooks,
# and Python (`VektorDistClient`) / Rust (`HttpVektorClient`) application wrappers:

# Base URL of the VektorDist HTTP/1.1 gateway:
# VEKTORDIST_URL=http://127.0.0.1:8080

# Default multi-tenant organization header (`X-Org-Id`):
# VEKTORDIST_ORG_ID=default

# Scoped `vdk.<key_id>.<hex_tag>` bearer credential minted via `vektordist keygen`:
# VEKTORDIST_BEARER_TOKEN=
